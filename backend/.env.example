# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/swiftchat

# Secret used to sign JWT auth tokens
JWT_SECRET=your_jwt_secret

# Cloudinary credentials (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Port the server listens on
PORT=5000

# Deployed frontend origin, allowed through CORS alongside localhost:5173.
# No trailing slash. Leave unset locally. Accepts a comma-separated list if you
# need to allow a preview deployment too.
# FRONTEND_URL=https://swiftchat.onrender.com

# Number of proxy hops to trust, for correct client IPs in rate limiting.
# Leave unset locally. In production it defaults to 1 (Render); only set this
# if your host adds more hops. Never set it to "true".
# TRUST_PROXY=1

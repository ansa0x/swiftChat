# Origin of the backend API. No trailing slash, and no /api suffix — the app
# adds /api for REST calls and uses the bare origin for the socket connection.
#
# Local development:
VITE_API_URL=http://localhost:5000
#
# In production set this to the deployed backend, e.g.
# VITE_API_URL=https://swiftchat-api.onrender.com
#
# Note: Vite inlines VITE_* variables into the built bundle at build time, so
# this is baked in when you run `npm run build` and is visible to anyone who
# views the source. Never put secrets in here.
